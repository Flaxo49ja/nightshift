      {
        "technique": "T1053.006",
        "name": "Transient systemd unit started",
        "why": "A transient unit has no unit file, so systemd describes it as `Started [description] ...`. That bracket is the scheduler equivalent of running from memory, and it survives a different binary asking the manager to start one.",
        "looks_like": [
          "Started [systemd-run] /usr/sbin/true. (transient timer's service)",
          "Started <name>.timer. (on-disk timer being armed)"
